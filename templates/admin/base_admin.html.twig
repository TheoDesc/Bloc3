<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Administration{% endblock %} - LAN France</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-light">

<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="{{ path('admin_lan_index') }}">LAN France</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="adminNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('admin_lan_index') }}">
                        <i class="bi bi-controller"></i> LAN
                    </a>
                </li>

                {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('admin_user_index') }}">
                            <i class="bi bi-people"></i> Utilisateurs
                        </a>
                    </li>
                {% endif %}
            </ul>

            <div class="d-flex align-items-center gap-2">
                {% if app.user %}
                    <span class="text-white-50 small d-none d-md-inline">
                        {{ app.user.userIdentifier }}
                    </span>

                    <a href="{{ path('app_logout') }}" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-box-arrow-right"></i> Déconnexion
                    </a>
                {% endif %}

                <a href="{{ path('app_home') }}" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-box-arrow-up-right"></i> Voir le site
                </a>
            </div>
        </div>
    </div>
</nav>

<div class="container pb-5">

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <h1 class="h2 fw-bold mb-0">{% block admin_title %}{% endblock %}</h1>
            {% block admin_actions %}{% endblock %}
        </div>

        {% block admin_body %}{% endblock %}
    {% endblock %}

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

{% block javascripts %}{% endblock %}

</body>
</html>
