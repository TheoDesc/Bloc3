<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}Administration{% endblock %} - LAN France</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link rel="stylesheet" href="{{ asset('css/lan.css') }}">

    {% block stylesheets %}{% endblock %}
</head>

<body class="site-body">

<nav class="navbar navbar-expand-lg site-navbar">
    <div class="container">

        <a class="navbar-brand brand-mark" href="{{ path('admin_lan_index') }}">
            <span class="brand-icon">
                <i class="bi bi-controller"></i>
            </span>
            LAN <span class="brand-accent">FRANCE</span>
            <span class="badge bg-primary ms-2">ADMIN</span>
        </a>

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#adminNav"
            aria-controls="adminNav"
            aria-expanded="false"
            aria-label="Ouvrir ou fermer le menu"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="adminNav">

            <ul class="navbar-nav me-auto ms-lg-4">

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_home') }}">
                        <i class="bi bi-house me-1"></i>
                        Voir le site
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('admin_lan_index') }}">
                        <i class="bi bi-gear me-1"></i>
                        Gestion des LAN
                    </a>
                </li>

                {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('admin_user_index') }}">
                            <i class="bi bi-people me-1"></i>
                            Utilisateurs
                        </a>
                    </li>
                {% endif %}

            </ul>

            <div class="navbar-actions">
                {% if app.user %}
                    <span class="user-chip">
                        <i class="bi bi-person-circle me-1"></i>
                        {{ app.user.userIdentifier }}
                    </span>

                    <a href="{{ path('app_logout') }}" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-box-arrow-right me-1"></i>
                        Déconnexion
                    </a>
                {% endif %}
            </div>

        </div>
    </div>
</nav>

<main class="container site-main">

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fermer le message"
                ></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <span class="eyebrow">ESPACE ADMINISTRATEUR</span>
                <h1 class="h2 fw-bold mt-2 mb-0">
                    {% block admin_title %}{% endblock %}
                </h1>
            </div>

            {% block admin_actions %}{% endblock %}
        </div>

        {% block admin_body %}{% endblock %}

    {% endblock %}

</main>

<footer class="site-footer">
    <div class="container footer-inner">
        <span class="brand-mark">
            LAN <span class="brand-accent">FRANCE</span>
        </span>

        <p>Administration de la plateforme</p>

        <span class="footer-copy">
            © {{ 'now'|date('Y') }} LAN France
        </span>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

{% block javascripts %}{% endblock %}

</body>
</html>
