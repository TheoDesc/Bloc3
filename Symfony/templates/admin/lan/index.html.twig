{% extends 'admin/base_admin.html.twig' %}

{% block title %}Gestion des LAN{% endblock %}

{% block admin_title %}
    Gestion des LAN
{% endblock %}

{% block admin_actions %}
    <a href="{{ path('admin_lan_new') }}" class="btn btn-gradient">
        <i class="bi bi-plus-lg me-2"></i>
        Ajouter une LAN
    </a>
{% endblock %}

{% block admin_body %}

    <div class="sidebar-card mb-4">

        <div class="mb-3">
            <label for="recherche" class="form-label fw-bold">
                <i class="bi bi-search me-2"></i>
                Rechercher un événement
            </label>

            <input
                type="text"
                id="recherche"
                class="form-control"
                placeholder="Nom, ville ou jeu..."
                data-url="{{ path('admin_lan_search') }}"
                aria-controls="liste-lans"
            >
        </div>

        <p class="text-secondary small mb-0">
            Recherche parmi les événements enregistrés.
        </p>

    </div>

    <div class="sidebar-card">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="mb-0">Tous les événements</h2>

            <span class="event-count">
                <i class="bi bi-list-ul me-1"></i>
                Liste des LAN
            </span>
        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead>
                <tr>
                    <th>Nom</th>
                    <th>Ville</th>
                    <th>Date</th>
                    <th>Jeu</th>
                    <th>Actions</th>
                </tr>
                </thead>

                <tbody id="liste-lans" aria-live="polite" aria-busy="false">
                {% include 'admin/lan/_rows.html.twig' %}
                </tbody>

            </table>

        </div>

    </div>

{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const recherche = document.getElementById('recherche');
            const listeLans = document.getElementById('liste-lans');

            recherche.addEventListener('input', function () {
                listeLans.setAttribute('aria-busy', 'true');

                fetch(recherche.dataset.url + '?q=' + encodeURIComponent(recherche.value))
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Erreur lors de la recherche.');
                        }

                        return response.text();
                    })
                    .then(html => {
                        listeLans.innerHTML = html;
                    })
                    .catch(() => {
                        listeLans.innerHTML = `
                            <tr>
                                <td colspan="5" class="text-center py-4">
                                    Impossible de charger les résultats.
                                </td>
                            </tr>
                        `;
                    })
                    .finally(() => {
                        listeLans.setAttribute('aria-busy', 'false');
                    });
            });
        });
    </script>
{% endblock %}
