
{% extends 'base.html.twig' %}

{% block title %}Administration des LAN{% endblock %}

{% block body %}
    <div class="container my-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Gestion des LAN</h1>
            <a href="{{ path('admin_lan_new') }}" class="btn btn-primary">
                Ajouter une LAN
            </a>
        </div>

        <div class="mb-3">
            <input
                type="text"
                id="recherche"
                class="form-control"
                placeholder="Rechercher par nom, ville ou jeu..."
                data-url="{{ path('admin_lan_search') }}"
            >
        </div>

        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                <tr>
                    <th>Nom</th>
                    <th>Ville</th>
                    <th>Date</th>
                    <th>Jeu</th>
                    <th>Actions</th>
                </tr>
                </thead>

                <tbody id="liste-lans">
                {% include 'admin/lan/_rows.html.twig' %}
                </tbody>
            </table>
        </div>

    </div>

    <script>
        const recherche = document.getElementById('recherche');
        const listeLans = document.getElementById('liste-lans');

        recherche.addEventListener('input', function () {
            fetch(recherche.dataset.url + '?q=' + encodeURIComponent(recherche.value))
                .then(response => response.text())
                .then(html => {
                    listeLans.innerHTML = html;
                });
        });
    </script>
{% endblock %}
