
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}LAN France{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">LAN France</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menu">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_home') }}">Accueil</a>
                </li>

                {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('admin_lan_index') }}">Gestion des LAN</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('admin_lan_new') }}">Ajouter un LAN</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('admin_user_index') }}">Gestion des utilisateurs</a>
                    </li>
                {% endif %}
            </ul>

            {% if app.user %}
                <span class="navbar-text me-3">{{ app.user.userIdentifier }}</span>
                <a class="btn btn-outline-light btn-sm" href="{{ path('app_logout') }}">Déconnexion</a>
            {% else %}
                <a class="nav-link me-3" href="{{ path('app_login') }}">Connexion</a>
                <a class="btn btn-primary btn-sm" href="{{ path('app_register') }}">Créer un compte</a>
            {% endif %}
        </div>
    </div>
</nav>

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="container mt-3">
            <div class="alert alert-{{ label }}">{{ message }}</div>
        </div>
    {% endfor %}
{% endfor %}

{% block body %}{% endblock %}

<footer class="bg-dark text-light mt-5 py-4">
    <div class="container d-flex justify-content-between">
        <span>LAN France</span>
        <span>© {{ 'now'|date('Y') }}</span>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
