{% extends 'base.html.twig' %}

{% block title %}{{ lan.nom }} - LAN France{% endblock %}

{% block body %}

    <section class="detail-hero">

        {% if lan.image %}
            <img
                src="{{ asset(lan.image) }}"
                alt="Photo de {{ lan.nom }}"
                class="detail-cover"
            >
        {% endif %}

        <div class="detail-cover-shade"></div>

        <div class="container detail-hero-content">

            <a href="{{ path('app_home') }}" class="back-link">
                <i class="bi bi-arrow-left me-2"></i>
                Retour aux événements
            </a>

            <div class="mt-4">
                <span class="eyebrow">
                    <i class="bi bi-controller"></i>
                    ÉVÉNEMENT LAN
                </span>

                <h1>{{ lan.nom }}</h1>

                <div class="detail-meta">
                    <span>
                        <i class="bi bi-geo-alt"></i>
                        {{ lan.ville }}
                    </span>

                    <span>
                        <i class="bi bi-calendar-event"></i>
                        {{ lan.dateDebut|date('d/m/Y') }}
                    </span>

                    <span>
                        <i class="bi bi-controller"></i>
                        {{ lan.jeu }}
                    </span>
                </div>
            </div>

        </div>
    </section>

    <main class="container">

        <div class="detail-layout">

            <section>

                <span class="content-label">À PROPOS DE L'ÉVÉNEMENT</span>

                <h2 class="mt-2 fw-bold">Présentation</h2>

                <div class="detail-description">
                    {{ lan.description|nl2br }}
                </div>

                <div class="mt-5">

                    <span class="content-label">LOCALISATION</span>

                    <h2 class="mt-2 fw-bold">Où se déroule la LAN ?</h2>

                    <p class="detail-description">
                        <i class="bi bi-geo-alt text-gradient me-2"></i>
                        {{ lan.adresse ?: 'Adresse non renseignée' }},
                        {{ lan.ville }}
                    </p>

                    <div class="row g-3 mt-3">

                        <div class="col-md-6">
                            <div class="sidebar-card">
                                <p class="mb-1">Latitude</p>
                                <h5 class="mb-0">
                                    {{ lan.latitude ?? 'Non renseignée' }}
                                </h5>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="sidebar-card">
                                <p class="mb-1">Longitude</p>
                                <h5 class="mb-0">
                                    {{ lan.longitude ?? 'Non renseignée' }}
                                </h5>
                            </div>
                        </div>

                    </div>

                </div>

                <div class="mt-5">

                    <span class="content-label">ORGANISATION</span>

                    <h2 class="mt-2 fw-bold">Informations de contact</h2>

                    <div class="sidebar-card mt-3">
                        <p>
                            <i class="bi bi-person me-2"></i>
                            <strong>Contact :</strong>
                            {{ lan.nomContact ?: 'Non renseigné' }}
                        </p>

                        <p class="mb-0">
                            <i class="bi bi-envelope me-2"></i>
                            <strong>E-mail :</strong>

                            {% if lan.emailContact %}
                                <a href="mailto:{{ lan.emailContact }}">
                                    {{ lan.emailContact }}
                                </a>
                            {% else %}
                                Non renseigné
                            {% endif %}
                        </p>
                    </div>

                </div>

            </section>

            <aside class="sidebar-card">

                <span class="content-label">EN BREF</span>

                <h2>Informations pratiques</h2>

                <hr>

                <p>
                    <i class="bi bi-geo-alt me-2"></i>
                    <strong>Ville</strong><br>
                    {{ lan.ville }}
                </p>

                <p>
                    <i class="bi bi-signpost me-2"></i>
                    <strong>Adresse</strong><br>
                    {{ lan.adresse ?: 'Non renseignée' }}
                </p>

                <p>
                    <i class="bi bi-calendar-check me-2"></i>
                    <strong>Date de début</strong><br>
                    {{ lan.dateDebut|date('d/m/Y à H:i') }}
                </p>

                <p>
                    <i class="bi bi-calendar-x me-2"></i>
                    <strong>Date de fin</strong><br>
                    {{ lan.dateFin|date('d/m/Y à H:i') }}
                </p>

                <p>
                    <i class="bi bi-controller me-2"></i>
                    <strong>Jeu</strong><br>
                    {{ lan.jeu }}
                </p>

                <p>
                    <i class="bi bi-people me-2"></i>
                    <strong>Places disponibles au total</strong><br>
                    {{ lan.placesMax }}
                </p>

                <p>
                    <i class="bi bi-ticket-perforated me-2"></i>
                    <strong>Prix</strong><br>
                    <span class="text-gradient fw-bold fs-4">
                        {{ lan.prix|number_format(2, ',', ' ') }} €
                    </span>
                </p>

                <hr>

                <a
                    href="{{ path('app_lan_pdf', {id: lan.id}) }}"
                    class="btn btn-outline-light w-100"
                >
                    <i class="bi bi-file-earmark-pdf me-2"></i>
                    Télécharger la fiche PDF
                </a>

                {% if not app.user %}
                    <a
                        href="{{ path('app_register') }}"
                        class="btn btn-gradient w-100"
                    >
                        Créer un compte
                    </a>
                {% endif %}

            </aside>

        </div>

    </main>

{% endblock %}
